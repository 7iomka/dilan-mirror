{
  "page": {
    "displayName": "Page",
    "defaultPath": "src/pages",
    "questions": {
      "name": "Page name"
    },
    "folder": "{{kebab name}}",
    "files": [
      {
        "open": true,
        "name": "{{kebab name}}.component.tsx",
        "contentFile": "./page/name.component.txt"

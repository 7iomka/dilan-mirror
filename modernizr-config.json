{
  "classPrefix": "_",
  "enableClasses": true,
  "enableJSClass": true,
  "scriptGlobalName": "window",
  "usePrefixes": true,
  "minify": true,
  "options": ["addTest", "testProp", "setClasses"],
  "feature-detects": [
    "css/cssgrid",
    "css/shapes",
    "css/transforms3d",
    "css/transformstylepreserve3d",
    "css/vhunit",
    "css/vwunit",
    "svg/clippaths",
    "css/flexgap",
    "css/objectfit",
    "../../../src/shared/lib/modernizr/feature-detects/touchscreen"
  ]
}
